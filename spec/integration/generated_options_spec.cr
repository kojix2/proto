require "../support/generated_program"

private def limits_descriptor : Array(Proto::Bootstrap::FileDescriptorProto)
  bytes = File.read(File.join(__DIR__, "../fixtures/enum_compat/limits.pb")).to_slice
  reader = Proto::Wire::Reader.new(IO::Memory.new(bytes))
  files = [] of Proto::Bootstrap::FileDescriptorProto
  while tag = reader.read_tag
    if tag == {1, Proto::WireType::LENGTH_DELIMITED}
      files << Proto::Bootstrap::FileDescriptorProto.decode(reader.read_embedded)
    else
      reader.skip_tag(tag)
    end
  end
  files
end

describe "generated serialization options" do
  it "serializes fields whose names overlap generated local variables" do
    ProtoCompilationSpec.run(limits_descriptor, <<-CRYSTAL).should eq("names passed\n")
      require "./limits.pb"
      item = EnumAudit::OptionNames.new
      item.options = EnumAudit::Blob.new
      item.options.not_nil!.data = Bytes[42]
      item.io = Bytes[1, 2]
      item.sub = [7_u32, 8_u32]
      item.buf = [1, 2]
      options = Proto::EncodeOptions.new(max_field_length: 1024)
      restored = EnumAudit::OptionNames.decode(item.encode(options: options))
      raise "overlapping names" unless restored == item
      puts "names passed"
      CRYSTAL
  end

  it "merges a child generated by the earlier API" do
    bytes = File.read(File.join(__DIR__, "../fixtures/enum_compat/legacy.pb")).to_slice
    reader = Proto::Wire::Reader.new(IO::Memory.new(bytes))
    files = [] of Proto::Bootstrap::FileDescriptorProto
    while tag = reader.read_tag
      if tag == {1, Proto::WireType::LENGTH_DELIMITED}
        files << Proto::Bootstrap::FileDescriptorProto.decode(reader.read_embedded)
      else
        reader.skip_tag(tag)
      end
    end
    legacy_source = <<-CRYSTAL
      require "proto"
      module LegacyAudit
        class Child
          include Proto::Message
          getter values = [] of Int32
          def self.decode_partial(io : IO) : self
            message = new
            reader = Proto::Wire::Reader.new(io)
            while tag = reader.read_tag
              if tag == {1, Proto::WireType::VARINT}
                message.values << reader.read_int32
              else
                reader.skip_tag(tag)
              end
            end
            message
          end
          def encode_partial(io : IO) : Nil
            writer = Proto::Wire::Writer.new(io)
            values.each do |value|
              writer.write_tag(1, Proto::WireType::VARINT)
              writer.write_int32(value)
            end
          end
        end
      end
      CRYSTAL
    program = <<-CRYSTAL
      require "./legacy_parent.pb"
      decoded = LegacyAudit::Parent.decode(Bytes[10, 2, 8, 1, 10, 2, 8, 2])
      raise "legacy merge" unless decoded.child.not_nil!.values == [1, 2]
      puts "legacy passed"
      CRYSTAL
    ProtoCompilationSpec.run(files, program, overrides: {"legacy_child.pb.cr" => legacy_source}).should eq("legacy passed\n")
  end

  it "merges repeated embedded messages without losing fields or unknown data" do
    ProtoCompilationSpec.run(limits_descriptor, <<-CRYSTAL).should eq("merge passed\n")
      require "./limits.pb"
      # The first child has value=1, text="a", and an unknown varint; the
      # second child appends value=2 and switches the oneof to number=9.
      data = Bytes[10, 7, 8, 1, 18, 1, 97, 32, 123, 10, 4, 8, 2, 24, 9]
      parent = EnumAudit::MergeParent.decode(data)
      child = parent.child.not_nil!
      raise "repeated values" unless child.values == [1, 2]
      raise "oneof merge" unless child.number == 9 && child.text.empty?
      raise "unknown fields" unless child.unknown_fields.size == 1 && child.unknown_fields.first.data == 123_u64
      restored = EnumAudit::MergeParent.decode(parent.encode)
      raise "round trip" unless restored == parent
      puts "merge passed"
      CRYSTAL
  end

  it "propagates field limits through nested messages and maps" do
    ProtoCompilationSpec.run(limits_descriptor, <<-CRYSTAL).should eq("limits passed\n")
      require "./limits.pb"
      size = 8 * 1024 * 1024 + 1
      blob = EnumAudit::Blob.new
      blob.data = Bytes.new(size, 42_u8)
      envelope = EnumAudit::Envelope.new
      envelope.by_name["signal"] = blob
      begin
        envelope.encode
        raise "default encode limit ignored"
      rescue Proto::EncodeError
      end
      encode_options = Proto::EncodeOptions.new(max_field_length: size + 1024)
      decode_options = Proto::DecodeOptions.new(max_field_length: size + 1024)
      bytes = envelope.encode(options: encode_options)
      begin
        EnumAudit::Envelope.decode(bytes)
        raise "default decode limit ignored"
      rescue Proto::DecodeError
      end
      restored = EnumAudit::Envelope.decode(bytes, options: decode_options)
      raise "nested bytes changed" unless restored.by_name["signal"].data == blob.data
      io = IO::Memory.new
      envelope.encode(io, options: encode_options)
      raise "IO API" unless EnumAudit::Envelope.decode(IO::Memory.new(io.to_slice), options: decode_options).by_name["signal"].data.size == size
      puts "limits passed"
      CRYSTAL
  end

  it "enforces custom message and recursion limits" do
    ProtoCompilationSpec.run(limits_descriptor, <<-CRYSTAL).should eq("budgets passed\n")
      require "./limits.pb"
      blob = EnumAudit::Blob.new
      blob.data = Bytes.new(12, 1_u8)
      bytes = blob.encode
      begin
        EnumAudit::Blob.decode(bytes, options: Proto::DecodeOptions.new(max_message_size: 10_i64))
        raise "message limit ignored"
      rescue Proto::DecodeError
      end
      node = EnumAudit::Node.new
      node.child = EnumAudit::Node.new
      node.child.not_nil!.child = EnumAudit::Node.new
      data = node.encode
      EnumAudit::Node.decode(data, options: Proto::DecodeOptions.new(max_recursion_depth: 2))
      begin
        EnumAudit::Node.decode(data, options: Proto::DecodeOptions.new(max_recursion_depth: 1))
        raise "recursion limit ignored"
      rescue Proto::DecodeError
      end
      puts "budgets passed"
      CRYSTAL
  end
end
